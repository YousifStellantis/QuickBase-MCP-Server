# Copy to .env next to your config file (or set these in the MCP client config).
# .env is gitignored. Real environment variables always win over this file.
#
# Token: Quickbase > My preferences > Manage user tokens > New user token,
# then "Assign token to apps" for every app this server should reach.
# Use a SERVICE ACCOUNT token: personal tokens die with the account.

QB_REALM=yourcompany.quickbase.com
QB_USER_TOKEN=
QB_APP_ID=

# Multi-environment setups (see quickbase-mcp.config.example.json):
# QB_USER_TOKEN_DEV=
# QB_USER_TOKEN_PROD=

# Safety (defaults shown)
# QB_ALLOW_WRITES=false
# QB_ALLOW_DESTRUCTIVE=false
# QB_ALLOWED_APPS=bxxxxxxxx,byyyyyyyy

# Corporate network
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
# NODE_EXTRA_CA_CERTS=C:\certs\corporate-root.pem
